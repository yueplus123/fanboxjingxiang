{
  "manifest_version": 3,
  "name": "Fanbox 赞助填卡助手",
  "version": "0.1.0",
  "description": "在 Fanbox 支付页输入卡密，自动填入卡信息。只填写，不会自动提交。",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://payment.pixiv.net/*"],
      "js": ["fill.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
