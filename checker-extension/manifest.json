{
  "manifest_version": 3,
  "name": "Fanbox 账号采集助手",
  "version": "0.2.0",
  "description": "检测账号池是否已赞助某作者；在你自己登录的 Fanbox 页面里读取账号统计数据并上报。",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://*.fanbox.cc/*"],
      "exclude_matches": ["https://api.fanbox.cc/*", "https://accounts.pixiv.net/*"],
      "js": ["content.js", "collector.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
